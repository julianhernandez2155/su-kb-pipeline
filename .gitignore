# Secrets
.env

# Python build / dev
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
.pytest_cache/
build/
dist/

# OneDrive / Windows temp
.tmp/

# Per-machine state (changes every run; would create noise)
.sync-state.json

# Chat session transcripts -- keep folder structure, ignore contents
output/query-sessions/*
!output/query-sessions/.gitkeep

# Phase 1.1 access classification (ADR-0007):
# - access-manifest.jsonl carries normalized account IDs + raw API responses
#   containing user emails. Treat like .env -- never commit.
# - spaces.json carries the full /spaces/{id}/permissions raw with group IDs.
# - access-summary.md IS committed; it's sanitized (counts + folder source
#   names only, no PII).
output/_access/access-manifest.jsonl
output/_access/spaces.json

# Runtime junk at project root
job.json
response.json
.uvicorn*.log
