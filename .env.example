# Copy this file to .env and fill in your real credentials.
# .env is gitignored; .env.example is committed.
# See README.md "Setup" for how to obtain each value.

# Atlassian Cloud auth (su-jsm.atlassian.net) -- Confluence ingest layer
# Email must be @syr.edu; token format ATATT*
# Get a token at: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_EMAIL=your.netid@syr.edu
ATLASSIAN_TOKEN=ATATT-replace-with-your-atlassian-api-token

# Anthropic API key -- chat layer only (optional; UI degrades gracefully if missing)
# Format: sk-ant-api03-*
# Required to use the Query tab and to run scripts/run_eval.py / run_proposals.py / draft_hubs.py
ANTHROPIC_API_KEY=sk-ant-api03-replace-with-your-key

# Optional: override config path (defaults to ./sync_config.yaml at the repo root)
# KB_CONFIG=/absolute/path/to/sync_config.yaml
